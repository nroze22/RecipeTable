# Local development only: point the Vite dev server at a separately running Worker.
# Production uses same-origin /extract and /compile routes automatically.
VITE_RECIPE_WORKER_URL=http://localhost:8787

# Set to true to automatically ask Workers AI to refine ingredient-to-step links.
# The deterministic local compiler remains the fallback.
VITE_ENABLE_AI_COMPILER=false
