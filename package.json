{
  "name": "recipe-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false && tsc --noEmit --pretty false -p worker/tsconfig.json",
    "test": "vitest run && vitest run --root worker",
    "test:watch": "vitest",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy": "npm run build && npm run worker:deploy"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=22"
  }
}
